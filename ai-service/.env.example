FORGE_SERVICE_PORT=8086
FORGE_NACOS_ADDR=127.0.0.1:8848
FORGE_DB_URL=jdbc:postgresql://127.0.0.1:5432/forge?currentSchema=ai,extensions
FORGE_DB_SCHEMA=ai
FORGE_DB_USER=ai_app
FORGE_DB_PASSWORD=
FORGE_DB_MIGRATOR_USER=ai_migrator
FORGE_DB_MIGRATOR_PASSWORD=
FORGE_REDIS_HOST=127.0.0.1
FORGE_REDIS_PORT=6379
FORGE_SECURITY_ISSUER=http://localhost:8080/iam
FORGE_SECURITY_JWK_SET_URI=http://127.0.0.1:8101/oauth2/jwks
FORGE_ROCKETMQ_ENDPOINTS=127.0.0.1:8081
FORGE_IAM_URI=http://127.0.0.1:8101
FORGE_MANIFEST_TOKEN=
FORGE_OPS_TOKEN=

# 平台目录运营使用独立的 Platform Realm，不能复用租户 issuer/JWKS。
FORGE_PLATFORM_SECURITY_ISSUER=http://localhost:8080/iam/platform
FORGE_PLATFORM_SECURITY_JWK_SET_URI=http://127.0.0.1:8101/platform/oauth2/jwks

# 必配：与平台统一的业务时区，用于 token 月配额和日快照。
FORGE_BUSINESS_ZONE=Asia/Shanghai

# Runner只拿服务身份；模型/MCP原始密钥仅注入AI服务。
AI_RUNNER_BASE_URI=http://127.0.0.1:8181
AI_RUNNER_SERVICE_TOKEN=
AI_MANAGEMENT_PORT=9090
# 共享 Nacos 默认只暴露 health/info；AI 在独立管理端口保留 Prometheus。
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
AI_MODEL_SECRET_REFERENCES=MODEL_DEEPSEEK_API_KEY
MODEL_DEEPSEEK_API_KEY=
AI_MCP_SECRET_REFERENCES=
AI_MCP_TRUSTED_BUSINESS_ORIGINS=
