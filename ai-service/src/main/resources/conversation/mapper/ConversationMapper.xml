<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.saasforge.ai.conversation.mapper.ConversationMapper">
    <select id="lock" resultType="io.saasforge.ai.conversation.entity.Conversation">
        SELECT * FROM ai_conversation WHERE id = #{id} AND NOT deleted FOR UPDATE
