<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.saasforge.ai.contract.mapper.ContractMapper">
    <select id="readWithRlsOnly" resultType="io.saasforge.ai.contract.entity.ContractRecord">
        SELECT id, created_at, updated_at, created_by, updated_by, deleted
        FROM contract_record WHERE id = #{id} AND NOT deleted
    </select>
</mapper>
