AI_RUNNER_HOST=127.0.0.1
AI_RUNNER_PORT=8181
# 内网服务身份，与模型原始密钥无关；生产由 Secret 注入。
AI_RUNNER_SERVICE_TOKEN=replace-with-runner-service-token
AI_SERVICE_PROXY_URL=http://ai-service:8080/internal/runner
AI_RUNNER_ROOT=/tmp/ai-runner
AI_RUNNER_MAX_TENANTS=8
AI_RUNNER_IDLE_TIMEOUT_MS=900000
AI_RUNNER_HEAP_MB=256
AI_RUNNER_CPU_SECONDS=120
AI_RUNNER_MAX_TURN_MS=120000
AI_RUNNER_RPC_TIMEOUT_MS=15000
